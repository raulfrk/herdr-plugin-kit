#!/bin/sh
set -eu

mode=${1:-}
base=${2:-}
case "$mode" in
  changed|full) ;;
  *) echo "usage: mutation-run changed <base-commit> | full" >&2; exit 2 ;;
esac
if [ "$mode" = changed ] && [ -z "$base" ]; then
  echo "changed mode requires a base commit" >&2
  exit 2
fi

repo=$(git rev-parse --show-toplevel)
candidate=$(git rev-parse HEAD)
if [ -n "$(git status --porcelain)" ]; then
  echo "mutation testing requires a clean committed candidate" >&2
  exit 2
fi

if [ "$mode" = changed ]; then
  if [ "$base" = 4b825dc642cb6eb9a060e54bf8d69288fbee4904 ]; then
    base=$(git -C "$repo" rev-list --max-parents=0 "$candidate")
  fi
  base_tree=$(git -C "$repo" show -s --format=%T "$base" 2>/dev/null || true)
  if [ "$base_tree" = 4b825dc642cb6eb9a060e54bf8d69288fbee4904 ]; then
    echo "empty-root changes require make mutation-full" >&2
    exit 2
  fi
fi

cpu_count=$(getconf _NPROCESSORS_ONLN 2>/dev/null || echo 2)
half=$((cpu_count / 2))
if [ "$half" -lt 1 ]; then half=1; fi
workers=${MUTATION_WORKERS:-$half}
case "$workers" in
  ''|*[!0-9]*) echo "MUTATION_WORKERS must be a positive integer" >&2; exit 2 ;;
esac
if [ "$workers" -lt 1 ] || [ "$workers" -gt "$half" ]; then
  echo "MUTATION_WORKERS must be between 1 and $half" >&2
  exit 2
fi

patch_hash=$(sha256sum "$repo/testtools/gremlins-constant-coverage.patch")
patch_hash=${patch_hash%% *}
gremlins_version="v0.6.0+hpk.constants.$patch_hash"
artifact_parent="$repo/.artifacts/mutation/$candidate"
artifact_dir="$artifact_parent/$mode"
if [ -e "$artifact_dir" ]; then
  echo "mutation artifacts already exist: $artifact_dir" >&2
  exit 2
fi
set -- preflight --policy mutation-policy.json \
  --baseline docs/mutation-baseline.md --config .gremlins.yaml \
  --scope "$mode" --gremlins-version "$gremlins_version"
if [ "$mode" = full ] && [ -e "$repo/mutation-full-baseline.json" ]; then
  set -- "$@" --full-baseline mutation-full-baseline.json
fi
(cd "$repo" && GOTOOLCHAIN=${GOTOOLCHAIN:-go1.27.0} \
  go run ./cmd/mutationgate "$@" >/dev/null)

lock=${TMPDIR:-/tmp}/herdr-plugin-kit-exclusive.lock
if ! mkdir "$lock" 2>/dev/null; then
  echo "mutation or live-device testing already holds $lock" >&2
  exit 2
fi
run_root=
worktree=
cleanup() {
  if [ -n "$worktree" ]; then
    git -C "$repo" worktree remove --force "$worktree" >/dev/null 2>&1 || true
  fi
  if [ -n "$run_root" ]; then
    find "$run_root" -depth -delete 2>/dev/null || true
  fi
  rmdir "$lock" 2>/dev/null || true
}
trap cleanup EXIT HUP INT TERM
run_root=$(mktemp -d "${TMPDIR:-/tmp}/herdr-plugin-kit-mutation.XXXXXX")
worktree="$run_root/worktree"

gremlins_bin="$run_root/gremlins"
GOTOOLCHAIN=${GOTOOLCHAIN:-go1.27.0} "$repo/scripts/gremlins-build" "$gremlins_bin"

git -C "$repo" worktree add --detach "$worktree" "$candidate" >/dev/null
report="$run_root/gremlins.json"
gate_report="$run_root/gate.json"
gate_stderr="$run_root/gate.stderr"
before_manifest="$run_root/source-before.sha256"
after_manifest="$run_root/source-after.sha256"
write_source_manifest() {
  git ls-files -z | LC_ALL=C sort -z | xargs -0 -r sh -c '
    set -e
    for file do
      if [ -L "$file" ]; then
        target=$(readlink -n -- "$file" && printf x)
        target=${target%?}
        digest=$(printf %s "$target" | sha256sum)
        digest=${digest%% *}
        printf "%s  %s\n" "$digest" "$file"
      else
        sha256sum "$file"
      fi
    done
  ' sh
}
(cd "$worktree" && write_source_manifest) > "$before_manifest"

set -- unleash --workers "$workers" --output "$report"
if [ "$mode" = changed ]; then
  set -- "$@" --diff "$base"
fi

(cd "$worktree" && "$gremlins_bin" "$@")
(cd "$worktree" && write_source_manifest) > "$after_manifest"
cmp "$before_manifest" "$after_manifest"
if [ -n "$(git -C "$worktree" status --porcelain --untracked-files=all)" ]; then
  echo "mutation run changed the candidate worktree" >&2
  exit 1
fi
gate_status=0
set -- check --report "$report" --policy mutation-policy.json \
  --baseline docs/mutation-baseline.md --config .gremlins.yaml \
  --candidate "$candidate" --base "$base" --scope "$mode" \
  --gremlins-version "$gremlins_version" --output "$gate_report"
if [ "$mode" = full ] && [ -e "$worktree/mutation-full-baseline.json" ]; then
  set -- "$@" --full-baseline mutation-full-baseline.json
fi
(cd "$worktree" && GOTOOLCHAIN=${GOTOOLCHAIN:-go1.27.0} \
  go run ./cmd/mutationgate "$@" 2>"$gate_stderr") || gate_status=$?
if [ ! -f "$gate_report" ]; then
  printf '%s\n' \
    '{"passed":false,"violations":["mutationgate failed before producing a gate report; see gate.stderr"]}' \
    > "$gate_report"
fi

mkdir -p "$artifact_parent"
if ! mkdir "$artifact_dir"; then
  echo "refusing to overwrite mutation artifacts: $artifact_dir" >&2
  exit 2
fi
install -m 0644 "$report" "$artifact_dir/gremlins.json"
install -m 0644 "$gate_report" "$artifact_dir/gate.json"
install -m 0644 "$gate_stderr" "$artifact_dir/gate.stderr"
install -m 0644 "$before_manifest" "$artifact_dir/source-before.sha256"
install -m 0644 "$after_manifest" "$artifact_dir/source-after.sha256"
(cd "$artifact_dir" && sha256sum gremlins.json gate.json gate.stderr \
  source-before.sha256 source-after.sha256 > SHA256SUMS)
echo "mutation artifacts: $artifact_dir"
exit "$gate_status"
