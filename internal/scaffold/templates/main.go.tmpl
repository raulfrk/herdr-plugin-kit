const examplePageSize = 4

var exampleItems = []interaction.Item{
	{Key: "recall-plan", Label: "Recall the plugin plan", Description: "Search prior planning decisions", Detail: []string{"Reference workflow · stable tie A"}},
	{Key: "recall-code", Label: "Recall Codex notes", Description: "Search agent implementation notes", Detail: []string{"Reference workflow · stable tie B"}},
	{Key: "attention", Label: "Attention Switcher", Description: "Focus an agent needing input", Detail: []string{"Agent state is provider-owned"}},
	{Key: "session", Label: "Session Switcher", Description: "Find and reopen a session", Detail: []string{"Supports opening at a directory"}},
	{Key: "config", Label: "Plugin Configurator", Description: "Edit TOML or YAML safely", Detail: []string{"Revision-checked writes"}},
	{Key: "actions", Label: "Action Finder", Description: "Fuzzy-find runnable plugin actions", Detail: []string{"Like a command palette"}},
	{Key: "unicode-accent", Label: "Résumé archive", Description: "Canonical Unicode search example"},
	{Key: "unicode-combining", Label: "Cafe\u0301 session", Description: "Combining-mark search example"},
	{Key: "unicode-wide", Label: "作業セッション", Description: "Wide-character layout example"},
	{Key: "disabled", Label: "Unavailable provider", Description: "Visible but intentionally disabled", Disabled: true},
	{Key: "stable-a", Label: "Shared result", Description: "Equal-score provider order A"},
	{Key: "stable-b", Label: "Shared result", Description: "Equal-score provider order B"},
}

func main() {
	if err := run(os.Args[1:]); err != nil {
		fmt.Fprintln(os.Stderr, err)
		os.Exit(1)
	}
}

func run(args []string) error {
	if len(args) == 0 {
		return errors.New("usage: plugin ui|debug|action")
	}
	switch args[0] {
	case "ui":
		if len(args) != 1 {
			return errors.New("ui accepts no arguments")
		}
		return runUI(os.Getenv("HERDR_PLUGIN_START_VIEW") == "debug")
	case "debug":
		if len(args) != 1 {
			return errors.New("debug accepts no arguments")
		}
		return runUI(true)
	case "action":
		if len(args) != 2 {
			return errors.New("usage: plugin action open|debug|health")
		}
		return runAction(args[1])
	default:
		return fmt.Errorf("unknown subcommand %q", args[0])
	}
}

func runUI(debug bool) (result error) {
	resources, err := openResources()
	if err != nil {
		return err
	}
	defer func() { result = errors.Join(result, resources.Close()) }()
	recording, err := debugui.NewRecording(resources.recorder, resources.previews, previewingSink{resources})
	if err != nil {
		return err
	}
	defer func() { result = errors.Join(result, recording.Close()) }()
	debugSurface, err := debugui.New(debugui.Options{
		Recorder: resources.recorder, Previews: resources.previews,
		Exporter: resources.exportDebug, MaxReportBytes: 64 << 10, PageSize: 100, RecordingStatus: recording.Status,
	})
	if err != nil {
		return err
	}
	mainSurface, err := interaction.NewPicker(interaction.PickerOptions{
		Title:    pluginName,
		Load:     loadExamplePage,
		Activate: resources.activate,
	})
	if err != nil {
		return err
	}
	surface := &surfaceRouter{
		main: mainSurface, debug: debugSurface,
		mainEditing: mainSurface.Editing, debugEditing: debugSurface.Editing,
		showingDebug: debug,
	}
	id, err := diagnostics.NewID(pluginID)
	if err != nil {
		return err
	}
	configDirectory, err := runtimeDirectory("HERDR_PLUGIN_CONFIG_DIR")
	if err != nil {
		return err
	}
	palette, err := loadPalette(configDirectory)
	if err != nil {
		return err
	}
	program, err := shell.NewProgram(shell.ProgramOptions{PluginID: id, Theme: palette, Events: recording}, surface)
	if err != nil {
		return err
	}
	_, err = program.Run()
	return err
}

func loadExamplePage(_ context.Context, query string, cursor interaction.Cursor) (interaction.Page, error) {
	offset, err := cursorOffset(query, cursor)
	if err != nil {
		return interaction.Page{}, err
	}
	candidates := make([]interaction.Candidate, len(exampleItems))
	itemsByKey := make(map[string]interaction.Item, len(exampleItems))
	for index, item := range exampleItems {
		candidates[index] = interaction.Candidate{Key: item.Key, Text: item.Label + " " + item.Description}
		itemsByKey[item.Key] = item
	}
	matches := interaction.Rank(query, candidates)
	if offset > len(matches) {
		return interaction.Page{}, errors.New("cursor is outside the result set")
	}
	end := min(offset+examplePageSize, len(matches))
	page := interaction.Page{Items: make([]interaction.Item, 0, end-offset)}
	for _, match := range matches[offset:end] {
		page.Items = append(page.Items, itemsByKey[match.Candidate.Key])
	}
	if end < len(matches) {
		page.Next = interaction.NewCursor(queryCursor(query, end))
	}
	return page, nil
}

func queryCursor(query string, offset int) string {
	return queryCursorPrefix(query) + strconv.Itoa(offset)
}

func queryCursorPrefix(query string) string {
	digest := sha256.Sum256([]byte(query))
	return fmt.Sprintf("q-%x:", digest[:8])
}

func cursorOffset(query string, cursor interaction.Cursor) (int, error) {
	if cursor.Empty() {
		return 0, nil
	}
	value, ok := strings.CutPrefix(cursor.Token(), queryCursorPrefix(query))
	if !ok {
		return 0, errors.New("cursor does not belong to this query")
	}
	offset, err := strconv.Atoi(value)
	if err != nil || offset < 0 {
		return 0, errors.New("cursor offset is invalid")
	}
	return offset, nil
}

// surfaceRouter keeps normal and debug views in one process so both observe
// the same recorder. Alt+D switches views without colliding with text entry.
type surfaceRouter struct {
	main, debug               shell.Surface
	mainEditing, debugEditing func() bool
	showingDebug              bool
	lastResize                shell.ResizeEvent
}

func (router *surfaceRouter) Update(events shell.EventContext, event shell.Event) []shell.Effect {
	if text, ok := event.(shell.TextEvent); ok && !text.Paste && text.Text == "d" &&
		(text.Alt || !router.editing()) {
		router.showingDebug = !router.showingDebug
		if router.lastResize.Generation > 0 {
			return router.active().Update(events, router.lastResize)
		}
		return nil
	}
	if resize, ok := event.(shell.ResizeEvent); ok {
		if resize.Generation > router.lastResize.Generation {
			router.lastResize = resize
		}
	}
	switch event.(type) {
	case shell.ResultEvent, shell.TimerEvent:
		mainEffects := router.main.Update(events, event)
		debugEffects := router.debug.Update(events, event)
		return append(mainEffects, debugEffects...)
	}
	return router.active().Update(events, event)
}

func (router *surfaceRouter) editing() bool {
	if router.showingDebug {
		return router.debugEditing != nil && router.debugEditing()
	}
	return router.mainEditing != nil && router.mainEditing()
}

func (router *surfaceRouter) Render(context shell.RenderContext) (*view.Frame, error) {
	return router.active().Render(context)
}

func (router *surfaceRouter) DiagnosticState() diagnostics.VisualState {
	return router.active().DiagnosticState()
}

func (router *surfaceRouter) SuppressEventDiagnostics(event shell.Event) bool {
	filter, ok := router.debug.(shell.DiagnosticFilter)
	return ok && filter.SuppressEventDiagnostics(event)
}

func (router *surfaceRouter) SuppressEffectDiagnostics(effect shell.Effect) bool {
	filter, ok := router.debug.(shell.DiagnosticFilter)
	return ok && filter.SuppressEffectDiagnostics(effect)
}

func (router *surfaceRouter) active() shell.Surface {
	if router.showingDebug {
		return router.debug
	}
	return router.main
}

func runAction(action string) error {
	switch action {
	case "open", "debug":
		herdr := os.Getenv("HERDR_BIN_PATH")
		if herdr == "" {
			return errors.New("HERDR_BIN_PATH is empty")
		}
		ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
		defer cancel()
		arguments := []string{
			"plugin", "pane", "open", "--plugin", pluginID, "--entrypoint", "main",
			"--placement", "popup", "--width", "100%", "--height", "100%",
		}
		if action == "debug" {
			arguments = append(arguments, "--env", "HERDR_PLUGIN_START_VIEW=debug")
		}
		arguments = append(arguments, "--focus")
		_, err := (command.ExecRunner{}).Run(ctx, herdr, arguments)
		return err
	case "health":
		if _, err := runtimeDirectory("HERDR_PLUGIN_CONFIG_DIR"); err != nil {
			return err
		}
		if _, err := runtimeDirectory("HERDR_PLUGIN_STATE_DIR"); err != nil {
			return err
		}
		return json.NewEncoder(os.Stdout).Encode(healthResponse())
	default:
		return fmt.Errorf("unknown action %q", action)
	}
}

func healthResponse() interop.ActionResponse {
	return interop.ActionResponse{
		Version: interop.Version, Interface: "health", InterfaceVersion: 1,
		Method: "check", Payload: json.RawMessage(`{"ok":true}`),
	}
}

type pluginConfig struct {
	Theme theme.Settings `toml:"theme"`
}

func loadPalette(directory string) (theme.Palette, error) {
	loader := config.Loader[pluginConfig]{Defaults: func() pluginConfig {
		return pluginConfig{Theme: theme.DefaultSettings()}
	}, Validate: func(value pluginConfig) error { return value.Theme.Validate() }}
	data, err := os.ReadFile(filepath.Join(directory, "config.toml"))
	if errors.Is(err, os.ErrNotExist) {
		data = nil
	} else if err != nil {
		return theme.Palette{}, fmt.Errorf("read plugin config: %w", err)
	}
	value, err := loader.Decode(data)
	if err != nil {
		return theme.Palette{}, err
	}
	value.Theme.AutoSwitch = false
	return value.Theme.Resolve(false)
}

type resources struct {
	recorder  *diagnostics.Recorder
	previews  *diagnostics.PreviewStore
	documents *documentstore.Store
	owner     *os.File
}

func openResources() (*resources, error) {
	if _, err := runtimeDirectory("HERDR_PLUGIN_CONFIG_DIR"); err != nil {
		return nil, err
	}
	stateDirectory, err := runtimeDirectory("HERDR_PLUGIN_STATE_DIR")
	if err != nil {
		return nil, err
	}
	directory := filepath.Join(stateDirectory, "diagnostics")
	if err := os.MkdirAll(directory, 0o700); err != nil {
		return nil, err
	}
	owner, err := os.Open(directory)
	if err != nil {
		return nil, err
	}
	if err := syscall.Flock(int(owner.Fd()), syscall.LOCK_EX|syscall.LOCK_NB); err != nil {
		return nil, errors.Join(errors.New("plugin UI or debugger is already open"), owner.Close())
	}
	recorder, err := diagnostics.Open(diagnostics.DefaultConfig(directory))
	if err != nil {
		return nil, errors.Join(err, closeLockedOwner(owner))
	}
	previews, err := diagnostics.OpenPreviewStore(stateDirectory, diagnostics.DefaultPreviewLimits())
	if err != nil {
		return nil, errors.Join(err, recorder.Close(), closeLockedOwner(owner))
	}
	documents, err := documentstore.Open(stateDirectory)
	if err != nil {
		return nil, errors.Join(err, previews.Close(), recorder.Close(), closeLockedOwner(owner))
	}
	return &resources{recorder: recorder, previews: previews, documents: documents, owner: owner}, nil
}

func (resources *resources) Close() error {
	return errors.Join(resources.documents.Close(), resources.previews.Close(), resources.recorder.Close(), closeLockedOwner(resources.owner))
}

func closeLockedOwner(owner *os.File) error {
	return errors.Join(syscall.Flock(int(owner.Fd()), syscall.LOCK_UN), owner.Close())
}

func (resources *resources) writeDocument(ctx context.Context, name string, data []byte) error {
	expected := documentstore.Revision{}
	current, err := resources.documents.Read(ctx, name)
	if err == nil {
		expected = current.Revision
	} else if !errors.Is(err, os.ErrNotExist) {
		return err
	}
	_, err = resources.documents.WritePrivate(ctx, name, data, expected)
	return err
}

func (resources *resources) exportDebug(ctx context.Context, data []byte) error {
	return resources.writeDocument(ctx, "debug-report.json", data)
}

func (resources *resources) activate(ctx context.Context, item interaction.Item) error {
	data, err := json.Marshal(struct {
		Key    string `json:"key"`
		Status string `json:"status"`
	}{Key: item.Key, Status: "activated"})
	if err != nil {
		return err
	}
	return resources.writeDocument(ctx, "last-activation.json", append(data, '\n'))
}

// previewingSink remains the synchronous non-debugger path used by generated
// consumer contract tests. The interactive program uses Recording above.
type previewingSink struct{ resources *resources }

func (sink previewingSink) RecordSemantic(event diagnostics.SemanticEvent) error {
	sequence, err := sink.resources.recorder.RecordSemanticWithSequence(event)
	if err != nil || event.Visual == nil {
		return err
	}
	_, _ = sink.resources.previews.Put(sequence, *event.Visual)
	return nil
}

func runtimeDirectory(name string) (string, error) {
	directory := os.Getenv(name)
	if directory == "" || !filepath.IsAbs(directory) {
		return "", fmt.Errorf("%s must be an absolute directory", name)
	}
	if err := os.MkdirAll(directory, 0o700); err != nil {
		return "", fmt.Errorf("create %s: %w", name, err)
	}
	return directory, nil
}
