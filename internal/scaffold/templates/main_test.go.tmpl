func TestExampleSearchUsesStableUnicodeRankingAndOpaquePaging(t *testing.T) {
	var all []interaction.Item
	cursor := interaction.Cursor{}
	pages := 0
	for {
		page, err := loadExamplePage(context.Background(), "", cursor)
		if err != nil {
			t.Fatal(err)
		}
		pages++
		all = append(all, page.Items...)
		if page.Next.Empty() {
			break
		}
		if page.Next.Token() == "4" {
			t.Fatal("cursor exposed a raw offset")
		}
		cursor = page.Next
	}
	if pages != 3 || len(all) != len(exampleItems) {
		t.Fatalf("paging = %d pages, %d items", pages, len(all))
	}
	shared, err := loadExamplePage(context.Background(), "shared result", interaction.Cursor{})
	if err != nil {
		t.Fatal(err)
	}
	if len(shared.Items) < 2 || shared.Items[0].Key != "stable-a" || shared.Items[1].Key != "stable-b" {
		t.Fatalf("stable equal-score order = %#v", shared.Items)
	}
	for query, want := range map[string]string{"résumé": "unicode-accent", "cafe": "unicode-combining", "作業": "unicode-wide"} {
		page, err := loadExamplePage(context.Background(), query, interaction.Cursor{})
		if err != nil || len(page.Items) == 0 || page.Items[0].Key != want {
			t.Fatalf("search %q = %#v, %v", query, page.Items, err)
		}
	}
	disabled, err := loadExamplePage(context.Background(), "unavailable", interaction.Cursor{})
	if err != nil || len(disabled.Items) != 1 || !disabled.Items[0].Disabled {
		t.Fatalf("disabled result = %#v, %v", disabled.Items, err)
	}
	first, _ := loadExamplePage(context.Background(), "recall", interaction.Cursor{})
	if !first.Next.Empty() {
		if _, err := loadExamplePage(context.Background(), "session", first.Next); err == nil {
			t.Fatal("accepted a cursor from another query")
		}
	}
}

func TestExampleActivationAndDebugExportAreOwnerOnlyDocuments(t *testing.T) {
	directory := t.TempDir()
	store, err := documentstore.Open(directory)
	if err != nil {
		t.Fatal(err)
	}
	defer store.Close()
	resources := &resources{documents: store}
	if err := resources.activate(context.Background(), interaction.Item{Key: "session"}); err != nil {
		t.Fatal(err)
	}
	if err := resources.exportDebug(context.Background(), []byte(`{"version":1}`)); err != nil {
		t.Fatal(err)
	}
	for _, name := range []string{"last-activation.json", "debug-report.json"} {
		if err := os.Chmod(filepath.Join(directory, name), 0o644); err != nil {
			t.Fatal(err)
		}
	}
	if err := resources.activate(context.Background(), interaction.Item{Key: "attention"}); err != nil {
		t.Fatal(err)
	}
	if err := resources.exportDebug(context.Background(), []byte(`{"version":1,"updated":true}`)); err != nil {
		t.Fatal(err)
	}
	for _, name := range []string{"last-activation.json", "debug-report.json"} {
		info, err := os.Stat(filepath.Join(directory, name))
		if err != nil || info.Mode().Perm() != 0o600 {
			t.Fatalf("%s mode = %v, %v", name, info, err)
		}
	}
	activation, err := os.ReadFile(filepath.Join(directory, "last-activation.json"))
	if err != nil {
		t.Fatal(err)
	}
	var result struct{ Key, Status string }
	if err := json.Unmarshal(activation, &result); err != nil || result.Key != "attention" || result.Status != "activated" {
		t.Fatalf("activation receipt = %#v, %v", result, err)
	}
}

func TestGeneratedOpenActionsUseFocusedFullSizePopup(t *testing.T) {
	directory := t.TempDir()
	capture := filepath.Join(directory, "arguments")
	herdr := filepath.Join(directory, "herdr")
	script := "#!/bin/sh\nprintf '%s\\n' \"$@\" > \"$HERDR_TEST_CAPTURE\"\n"
	if err := os.WriteFile(herdr, []byte(script), 0o700); err != nil {
		t.Fatal(err)
	}
	t.Setenv("HERDR_BIN_PATH", herdr)
	t.Setenv("HERDR_TEST_CAPTURE", capture)
	base := []string{
		"plugin", "pane", "open", "--plugin", pluginID, "--entrypoint", "main",
		"--placement", "popup", "--width", "100%", "--height", "100%",
	}
	for _, test := range []struct {
		action string
		extra  []string
	}{
		{action: "open"},
		{action: "debug", extra: []string{"--env", "HERDR_PLUGIN_START_VIEW=debug"}},
	} {
		if err := runAction(test.action); err != nil {
			t.Fatalf("%s action: %v", test.action, err)
		}
		data, err := os.ReadFile(capture)
		if err != nil {
			t.Fatal(err)
		}
		want := append(append(append([]string{}, base...), test.extra...), "--focus")
		if got := strings.Split(strings.TrimSpace(string(data)), "\n"); !slices.Equal(got, want) {
			t.Fatalf("%s arguments = %q, want %q", test.action, got, want)
		}
	}
}

func TestPreviewingSinkRegistersTheRecordedSemanticState(t *testing.T) {
	directory := t.TempDir()
	recorder, err := diagnostics.Open(diagnostics.DefaultConfig(directory))
	if err != nil {
		t.Fatal(err)
	}
	defer recorder.Close()
	previews, err := diagnostics.OpenPreviewStore(directory, diagnostics.PreviewLimits{MaxCount: 1, MaxBytes: 1 << 20})
	if err != nil {
		t.Fatal(err)
	}
	defer previews.Close()
	resources := &resources{recorder: recorder, previews: previews}
	plugin, _ := diagnostics.NewID(pluginID)
	code, _ := diagnostics.NewID("example.preview")
	stateID, _ := diagnostics.NewID("ready")
	visual := diagnostics.VisualState{Screen: code, State: stateID, ItemCount: 3}
	if err := (previewingSink{resources}).RecordSemantic(diagnostics.SemanticEvent{
		Level: diagnostics.LevelInfo, Kind: diagnostics.KindInteraction, Plugin: plugin,
		Code: code, Outcome: diagnostics.OutcomeApplied, Visual: &visual,
	}); err != nil {
		t.Fatal(err)
	}
	page, err := recorder.Debug(diagnostics.DebugQuery{PageSize: 1})
	if err != nil || len(page.Events) != 1 {
		t.Fatalf("debug page = %#v, %v", page, err)
	}
	if _, ok := previews.Entry(page.Events[0].Sequence, visual); !ok {
		t.Fatal("latest semantic state has no registered preview")
	}
	second := visual
	second.ItemCount++
	if err := (previewingSink{resources}).RecordSemantic(diagnostics.SemanticEvent{
		Level: diagnostics.LevelInfo, Kind: diagnostics.KindInteraction, Plugin: plugin,
		Code: code, Outcome: diagnostics.OutcomeApplied, Visual: &second,
	}); err != nil {
		t.Fatalf("preview exhaustion stopped semantic diagnostics: %v", err)
	}
	page, err = recorder.Debug(diagnostics.DebugQuery{PageSize: 2})
	if err != nil || len(page.Events) != 2 {
		t.Fatalf("events after preview exhaustion = %#v, %v", page.Events, err)
	}
	if _, ok := previews.Entry(page.Events[0].Sequence, second); ok {
		t.Fatal("preview store exceeded its count limit")
	}
}

func TestGeneratedSurfacesRenderEveryThemeAndResponsiveBoundary(t *testing.T) {
	recorder, err := diagnostics.Open(diagnostics.DefaultConfig(t.TempDir()))
	if err != nil {
		t.Fatal(err)
	}
	defer recorder.Close()
	picker, err := interaction.NewPicker(interaction.PickerOptions{Title: pluginName, Load: loadExamplePage})
	if err != nil {
		t.Fatal(err)
	}
	debugSurface, err := debugui.New(debugui.Options{Recorder: recorder})
	if err != nil {
		t.Fatal(err)
	}
	router := &surfaceRouter{
		main: picker, debug: debugSurface,
		mainEditing: picker.Editing, debugEditing: debugSurface.Editing,
	}
	initialPalette, _ := theme.Builtin("catppuccin")
	plugin, _ := diagnostics.NewID(pluginID)
	input, inputWriter := io.Pipe()
	program, err := shell.NewProgram(shell.ProgramOptions{
		PluginID: plugin, Theme: initialPalette, Events: recorder,
		Input: input, Output: io.Discard,
	}, router)
	if err != nil {
		t.Fatal(err)
	}
	done := make(chan error, 1)
	go func() { _, runErr := program.Run(); done <- runErr }()
	program.Send(tea.WindowSizeMsg{Width: 80, Height: 19})
	waitForVisualState(t, recorder, "ready", 4)
	program.Kill()
	if err := <-done; err != nil && !errors.Is(err, tea.ErrProgramKilled) {
		t.Fatal(err)
	}
	_ = inputWriter.Close()

	sizes := []responsive.Size{
		{Columns: 39, Rows: 9}, {Columns: 40, Rows: 10}, {Columns: 48, Rows: 18},
		{Columns: 48, Rows: 30}, {Columns: 78, Rows: 10}, {Columns: 78, Rows: 20},
		{Columns: 80, Rows: 18}, {Columns: 110, Rows: 24}, {Columns: 500, Rows: 200},
		// Approved live iPhone measurements: keyboard open, keyboard closed, and landscape.
		{Columns: 70, Rows: 37}, {Columns: 70, Rows: 67}, {Columns: 148, Rows: 39},
		{Columns: 5000, Rows: 2000},
	}
	for _, themeID := range theme.IDs() {
		palette, err := theme.Builtin(themeID)
		if err != nil {
			t.Fatal(err)
		}
		for _, size := range sizes {
			generation := router.lastResize.Generation + 1
			layout := responsive.Resolve(size)
			router.Update(shell.EventContext{}, shell.ResizeEvent{Layout: layout, Generation: generation})
			stale := responsive.Resolve(responsive.Size{Columns: 40, Rows: 10})
			router.Update(shell.EventContext{}, shell.ResizeEvent{Layout: stale, Generation: generation - 1})
			if router.lastResize.Generation != generation || router.lastResize.Layout != layout {
				t.Fatalf("%s %+v retained resize = %+v", themeID, size, router.lastResize)
			}
			context := shell.RenderContext{Layout: layout, Theme: palette, ResizeGeneration: generation, Settled: true}
			mainFrame, err := router.Render(context)
			if err != nil || mainFrame.Width() != layout.Render.Columns || mainFrame.Height() != layout.Render.Rows {
				t.Fatalf("%s %+v main frame = %v, %v", themeID, size, mainFrame, err)
			}
			if layout.Class != responsive.Recovery {
				plain := view.ANSI(mainFrame)
				if !strings.Contains(plain, "Recall the plugin plan") || !strings.Contains(plain, "? help") {
					t.Fatalf("%s %+v missing loaded row or controls", themeID, size)
				}
			}
			router.Update(shell.EventContext{}, shell.TextEvent{Text: "d"})
			debugFrame, err := router.Render(context)
			if err != nil || debugFrame.Width() != layout.Render.Columns || debugFrame.Height() != layout.Render.Rows {
				t.Fatalf("%s %+v debug frame = %v, %v", themeID, size, debugFrame, err)
			}
			if size == (responsive.Size{Columns: 39, Rows: 9}) && layout.Class != responsive.Recovery {
				t.Fatalf("recovery size resolved to %s", layout.Class)
			}
			if size == (responsive.Size{Columns: 5000, Rows: 2000}) && (!layout.Projected || layout.Render != (responsive.Size{Columns: 500, Rows: 200})) {
				t.Fatalf("oversized projection = %+v", layout)
			}
			router.Update(shell.EventContext{}, shell.TextEvent{Text: "d"})
		}
	}

	layout := responsive.Resolve(responsive.Size{Columns: 40, Rows: 10})
	picker.Update(shell.EventContext{}, shell.ResizeEvent{Layout: layout, Generation: router.lastResize.Generation + 1})
	picker.Update(shell.EventContext{}, shell.TextEvent{Text: "?"})
	palette, _ := theme.Builtin("catppuccin")
	frame, err := picker.Render(shell.RenderContext{Layout: layout, Theme: palette})
	if err != nil || !strings.Contains(view.ANSI(frame), "PICKER HELP") {
		t.Fatalf("compact help unavailable: %v", err)
	}
}

func TestGeneratedShellSuppressesSameTextQueryBurst(t *testing.T) {
	recorder, err := diagnostics.Open(diagnostics.DefaultConfig(t.TempDir()))
	if err != nil {
		t.Fatal(err)
	}
	defer recorder.Close()
	started := make(chan struct{})
	release := make(chan struct{})
	var matchingLoads atomic.Int32
	loader := func(ctx context.Context, query string, _ interaction.Cursor) (interaction.Page, error) {
		if query != "a" {
			return interaction.Page{Items: exampleItems[:4]}, nil
		}
		if matchingLoads.Add(1) == 1 {
			close(started)
			select {
			case <-release:
			case <-ctx.Done():
				return interaction.Page{}, ctx.Err()
			}
			return interaction.Page{Items: []interaction.Item{{Key: "old", Label: "Old result"}}}, nil
		}
		return interaction.Page{Items: []interaction.Item{{Key: "new", Label: "Newest result"}}}, nil
	}
	picker, err := interaction.NewPicker(interaction.PickerOptions{Title: pluginName, Load: loader})
	if err != nil {
		t.Fatal(err)
	}
	palette, _ := theme.Builtin("catppuccin")
	plugin, _ := diagnostics.NewID(pluginID)
	input, inputWriter := io.Pipe()
	program, err := shell.NewProgram(shell.ProgramOptions{
		PluginID: plugin, Theme: palette, Events: recorder, Input: input, Output: io.Discard,
	}, picker)
	if err != nil {
		t.Fatal(err)
	}
	done := make(chan error, 1)
	go func() { _, runErr := program.Run(); done <- runErr }()
	defer func() {
		program.Kill()
		_ = inputWriter.Close()
		select {
		case err := <-done:
			if err != nil && !errors.Is(err, tea.ErrProgramKilled) {
				t.Error(err)
			}
		case <-time.After(2 * time.Second):
			t.Error("generated query-burst program did not stop")
		}
	}()

	program.Send(tea.WindowSizeMsg{Width: 80, Height: 19})
	waitForVisualState(t, recorder, "ready", 4)
	program.Send(tea.KeyMsg{Type: tea.KeyRunes, Runes: []rune{'/'}})
	program.Send(tea.KeyMsg{Type: tea.KeyRunes, Runes: []rune{'a'}})
	select {
	case <-started:
	case <-time.After(2 * time.Second):
		t.Fatal("first matching query did not start")
	}
	program.Send(tea.KeyMsg{Type: tea.KeyRunes, Runes: []rune{'b'}})
	program.Send(tea.KeyMsg{Type: tea.KeyBackspace})
	close(release)
	waitForVisualState(t, recorder, "ready", 1)
	deadline := time.Now().Add(2 * time.Second)
	for matchingLoads.Load() != 2 && time.Now().Before(deadline) {
		time.Sleep(5 * time.Millisecond)
	}
	selected, ok := picker.Selected()
	if matchingLoads.Load() != 2 || !ok || selected.Key != "new" {
		t.Fatalf("matching loads = %d, selected = %#v, %t", matchingLoads.Load(), selected, ok)
	}
	page, err := recorder.Debug(diagnostics.DebugQuery{PageSize: 100})
	if err != nil {
		t.Fatal(err)
	}
	for _, event := range page.Events {
		if event.Visual != nil && event.Visual.State.String() == "debouncing" && event.Visual.ItemCount == 1 {
			t.Fatal("stale one-item result was committed during the newer debounce window")
		}
	}
}

func TestResourcesCloseReportsEveryCleanupFailure(t *testing.T) {
	root := t.TempDir()
	t.Setenv("HERDR_PLUGIN_CONFIG_DIR", root)
	t.Setenv("HERDR_PLUGIN_STATE_DIR", root)
	resources, err := openResources()
	if err != nil {
		t.Fatal(err)
	}
	if err := resources.documents.Close(); err != nil {
