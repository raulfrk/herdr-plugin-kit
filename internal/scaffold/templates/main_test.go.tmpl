	}
	if err := resources.Close(); !errors.Is(err, documentstore.ErrClosed) {
		t.Fatalf("Close() error = %v, want document-store close failure", err)
	}
}

func TestGeneratedRouterRejectsDisabledActivationAndExportsBoundedReport(t *testing.T) {
	stateDirectory := t.TempDir()
	diagnosticDirectory := filepath.Join(stateDirectory, "diagnostics")
	if err := os.MkdirAll(diagnosticDirectory, 0o700); err != nil {
		t.Fatal(err)
	}
	recorder, err := diagnostics.Open(diagnostics.DefaultConfig(diagnosticDirectory))
	if err != nil {
		t.Fatal(err)
	}
	previews, err := diagnostics.OpenPreviewStore(stateDirectory, diagnostics.DefaultPreviewLimits())
	if err != nil {
		t.Fatal(err)
	}
	documents, err := documentstore.Open(stateDirectory)
	if err != nil {
		t.Fatal(err)
	}
	resources := &resources{recorder: recorder, previews: previews, documents: documents}
	t.Cleanup(func() { _ = errors.Join(documents.Close(), previews.Close(), recorder.Close()) })

	plugin, _ := diagnostics.NewID(pluginID)
	code, _ := diagnostics.NewID("example.seed")
	longID, _ := diagnostics.NewID("seed-" + strings.Repeat("a", 100))
	seedVisual := diagnostics.VisualState{
		Screen: longID, Focus: longID, Selection: longID, State: longID,
		Geometry:         diagnostics.Geometry{ReportedColumns: 5000, ReportedRows: 2000, RenderColumns: 500, RenderRows: 200},
		ResizeGeneration: 100, RequestGeneration: 100, ItemCount: 100, SelectedIndex: 99, Pending: true,
	}
	for range 400 {
		if err := recorder.RecordSemantic(diagnostics.SemanticEvent{
			Level: diagnostics.LevelInfo, Kind: diagnostics.KindInteraction,
			Plugin: plugin, Component: longID, Action: longID, Correlation: longID,
			Code: code, Outcome: diagnostics.OutcomeApplied, Before: longID, After: longID,
			Geometry: seedVisual.Geometry, Visual: &seedVisual,
		}); err != nil {
			t.Fatal(err)
		}
	}

	picker, err := interaction.NewPicker(interaction.PickerOptions{Title: pluginName, Load: loadExamplePage, Activate: resources.activate})
	if err != nil {
		t.Fatal(err)
	}
	debugSurface, err := debugui.New(debugui.Options{
		Recorder: recorder, Previews: previews, Exporter: resources.exportDebug, MaxReportBytes: 64 << 10, PageSize: 100,
	})
	if err != nil {
		t.Fatal(err)
	}
	router := &surfaceRouter{
		main: picker, debug: debugSurface,
		mainEditing: picker.Editing, debugEditing: debugSurface.Editing,
	}
	palette, _ := theme.Builtin("catppuccin")
	input, inputWriter := io.Pipe()
	t.Cleanup(func() { _ = inputWriter.Close() })
	program, err := shell.NewProgram(shell.ProgramOptions{
		PluginID: plugin, Theme: palette, Events: previewingSink{resources}, Input: input, Output: io.Discard,
	}, router)
	if err != nil {
		t.Fatal(err)
	}
	done := make(chan error, 1)
	go func() { _, runErr := program.Run(); done <- runErr }()
	t.Cleanup(func() {
		program.Kill()
		select {
		case <-done:
		case <-time.After(2 * time.Second):
			t.Error("generated program did not stop")
		}
	})

	program.Send(tea.WindowSizeMsg{Width: 80, Height: 19})
	waitForVisualState(t, recorder, "ready", 4)
	program.Send(tea.KeyMsg{Type: tea.KeyRunes, Runes: []rune{'/'}})
	program.Send(tea.KeyMsg{Type: tea.KeyRunes, Runes: []rune("unavailable")})
	waitForVisualState(t, recorder, "ready", 1)
	program.Send(tea.KeyMsg{Type: tea.KeyEnter})
	waitForAction(t, recorder, "enter")
	if _, err := os.Stat(filepath.Join(stateDirectory, "last-activation.json")); !errors.Is(err, os.ErrNotExist) {
		t.Fatalf("disabled selection produced activation receipt: %v", err)
	}

	program.Send(tea.KeyMsg{Type: tea.KeyRunes, Runes: []rune{'d'}, Alt: true})
	program.Send(tea.KeyMsg{Type: tea.KeyRunes, Runes: []rune{'e'}})
	reportPath := filepath.Join(stateDirectory, "debug-report.json")
	var reportData []byte
	deadline := time.Now().Add(2 * time.Second)
	for time.Now().Before(deadline) {
		reportData, err = os.ReadFile(reportPath)
		if err == nil {
			break
		}
		time.Sleep(5 * time.Millisecond)
	}
	if err != nil {
		t.Fatalf("Debug UI did not export: %v", err)
	}
	if len(reportData) > 64<<10 {
		t.Fatalf("debug report has %d bytes", len(reportData))
	}
	var report diagnostics.DebugReport
	if err := json.Unmarshal(reportData, &report); err != nil {
		t.Fatal(err)
	}
	if len(report.Sessions) == 0 || report.Sessions[0].ID != plugin {
		t.Fatalf("debug report session IDs were not preserved: %#v", report.Sessions)
	}
	preservedVisualID := false
	for _, event := range report.Events {
		if event.Session == plugin && !event.Code.IsZero() && event.Visual != nil &&
			!event.Visual.Screen.IsZero() && !event.Visual.State.IsZero() {
			preservedVisualID = true
			break
		}
	}
	if !preservedVisualID {
		t.Fatal("debug report event and visual IDs were not preserved")
	}
	if !report.Truncated || len(report.Previews) == 0 {
		t.Fatalf("bounded report truncated=%t previews=%d", report.Truncated, len(report.Previews))
	}
	for _, preview := range report.Previews {
		if !strings.HasPrefix(preview.RelativePath, "snapshots/") {
			t.Fatalf("preview path = %q", preview.RelativePath)
		}
		if _, err := os.Stat(filepath.Join(stateDirectory, filepath.FromSlash(preview.RelativePath))); err != nil {
			t.Fatalf("exported preview %q is not under state directory: %v", preview.RelativePath, err)
		}
	}
}

func waitForVisualState(t *testing.T, recorder *diagnostics.Recorder, state string, itemCount int) {
	t.Helper()
	deadline := time.Now().Add(2 * time.Second)
	for time.Now().Before(deadline) {
		page, err := recorder.Debug(diagnostics.DebugQuery{PageSize: 100})
		if err != nil {
			t.Fatal(err)
		}
		for _, event := range page.Events {
			if event.Visual != nil && event.Visual.State.String() == state && event.Visual.ItemCount == itemCount {
				return
			}
		}
		time.Sleep(5 * time.Millisecond)
	}
	t.Fatalf("did not observe state %q with %d items", state, itemCount)
}

func waitForAction(t *testing.T, recorder *diagnostics.Recorder, action string) {
	t.Helper()
	deadline := time.Now().Add(2 * time.Second)
	for time.Now().Before(deadline) {
		page, err := recorder.Debug(diagnostics.DebugQuery{PageSize: 100})
		if err != nil {
			t.Fatal(err)
		}
		for _, event := range page.Events {
			if event.Action.String() == action {
				return
			}
		}
		time.Sleep(5 * time.Millisecond)
	}
	t.Fatalf("did not observe action %q", action)
}

type testSurface struct {
	results int
	resizes int
	texts   int
	timers  int
}

func (surface *testSurface) Update(_ shell.EventContext, event shell.Event) []shell.Effect {
	switch event.(type) {
	case shell.ResultEvent:
		surface.results++
	case shell.ResizeEvent:
		surface.resizes++
	case shell.TextEvent:
		surface.texts++
	case shell.TimerEvent:
		surface.timers++
	}
	return nil
}

func (*testSurface) Render(shell.RenderContext) (*view.Frame, error) { return nil, nil }
func (*testSurface) DiagnosticState() diagnostics.VisualState        { return diagnostics.VisualState{} }

func TestRouterDeliversCompletionsAcrossViewSwitches(t *testing.T) {
	mainSurface, debugSurface := &testSurface{}, &testSurface{}
	router := &surfaceRouter{main: mainSurface, debug: debugSurface, mainEditing: func() bool { return false }}
	router.Update(shell.EventContext{}, shell.ResizeEvent{Generation: 1})
	router.Update(shell.EventContext{}, shell.TextEvent{Text: "d"})
	router.Update(shell.EventContext{}, shell.ResultEvent{})
	router.Update(shell.EventContext{}, shell.TimerEvent{})
	router.Update(shell.EventContext{}, shell.TextEvent{Text: "d"})
	if mainSurface.results != 1 || debugSurface.results != 1 {
		t.Fatalf("result deliveries = main %d, debug %d", mainSurface.results, debugSurface.results)
	}
	if mainSurface.timers != 1 || debugSurface.timers != 1 {
		t.Fatalf("timer deliveries = main %d, debug %d", mainSurface.timers, debugSurface.timers)
	}
	if mainSurface.resizes != 2 || debugSurface.resizes != 1 || router.showingDebug {
		t.Fatalf("resize/switch state = main %d, debug %d, showing debug %t", mainSurface.resizes, debugSurface.resizes, router.showingDebug)
	}
}

func TestRouterPlainDebugKeyDoesNotStealQueryInput(t *testing.T) {
	mainSurface, debugSurface := &testSurface{}, &testSurface{}
	editing := true
	debugEditing := false
	router := &surfaceRouter{
		main: mainSurface, debug: debugSurface,
		mainEditing: func() bool { return editing }, debugEditing: func() bool { return debugEditing },
	}
	router.Update(shell.EventContext{}, shell.TextEvent{Text: "d"})
	if router.showingDebug || mainSurface.texts != 1 {
		t.Fatalf("editing route = showing debug %t, main texts %d", router.showingDebug, mainSurface.texts)
	}
	router.Update(shell.EventContext{}, shell.TextEvent{Text: "d", Alt: true})
	if !router.showingDebug {
		t.Fatal("Alt+D did not open diagnostics while editing")
	}
	editing = false
	debugEditing = true
	router.Update(shell.EventContext{}, shell.TextEvent{Text: "d"})
	if !router.showingDebug || debugSurface.texts != 1 {
		t.Fatalf("debug editing route = showing debug %t, debug texts %d", router.showingDebug, debugSurface.texts)
	}
	debugEditing = false
	router.Update(shell.EventContext{}, shell.TextEvent{Text: "d"})
	if router.showingDebug {
		t.Fatal("plain d did not return from diagnostics")
	}
}

func TestHealthResponseAndConfigurationContract(t *testing.T) {
	response := healthResponse()
	if response.Version != 1 || response.Interface != "health" || response.InterfaceVersion != 1 ||
		response.Method != "check" || !bytes.Equal(response.Payload, []byte(`{"ok":true}`)) {
		t.Fatalf("health response = %#v", response)
	}
	directory := t.TempDir()
	palette, err := loadPalette(directory)
	if err != nil || palette.ID != "catppuccin" {
		t.Fatalf("default palette = %q, %v", palette.ID, err)
	}
	if err := os.WriteFile(directory+"/config.toml", []byte("[theme]\nname = \"dracula\"\n[theme.custom]\naccent = \"#010203\"\n"), 0o600); err != nil {
		t.Fatal(err)
	}
	palette, err = loadPalette(directory)
	if err != nil || palette.ID != "dracula" || string(palette.Accent) != "#010203" {
		t.Fatalf("configured palette = %q, %v", palette.ID, err)
	}
	if err := os.WriteFile(directory+"/config.toml", []byte("unknown = true\n"), 0o600); err != nil {
		t.Fatal(err)
	}
	if _, err := loadPalette(directory); err == nil {
		t.Fatal("unknown configuration field was accepted")
	}
}
