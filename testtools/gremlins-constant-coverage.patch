+)
+
+func TestCaseExpressionMutantsFollowTheirSwitchCoverage(t *testing.T) {
+	const (
+		tagless = "package example\n\nfunc f(n int) string {\n\tswitch {\n\tcase n > 1:\n\t\treturn \"big\"\n\t}\n\treturn \"\"\n}\n"
+		tagged  = "package example\n\nfunc f(n int) bool {\n\tswitch m := n * 2; m {\n\tcase n + 1:\n\t\treturn true\n\t}\n\treturn false\n}\n"
+		literal = "package example\n\nfunc f(n int) bool {\n\tswitch {\n\tcase func() bool { return n > 1 }():\n\t\treturn true\n\t}\n\treturn false\n}\n"
+		nested  = "package example\n\nfunc f(n int) bool {\n\tswitch {\n\tcase true:\n\t\tswitch {\n\t\tcase n > 1:\n\t\t\treturn true\n\t\t}\n\t}\n\treturn false\n}\n"
+	)
+	// The function's first coverage block ends at the switch's opening brace.
+	header := coverage.Block{StartLine: 3, StartCol: 22, EndLine: 4, EndCol: 9}
+	taggedHeader := coverage.Block{StartLine: 3, StartCol: 20, EndLine: 4, EndCol: 23}
+	boolHeader := coverage.Block{StartLine: 3, StartCol: 20, EndLine: 4, EndCol: 9}
+	// The outer clause body starts after "case true:" and ends at the inner switch's brace.
+	outerBody := coverage.Block{StartLine: 5, StartCol: 12, EndLine: 6, EndCol: 10}
+
+	for _, tc := range []struct {
+		name    string
+		source  string
+		blocks  []coverage.Block
+		changes diff.Diff
+		want    map[string]mutator.Status
+	}{
+		{"tagless covered", tagless, []coverage.Block{header}, nil, map[string]mutator.Status{
+			"5:9 CONDITIONALS_BOUNDARY": mutator.Runnable, "5:9 CONDITIONALS_NEGATION": mutator.Runnable,
+		}},
+		{"tagless not covered", tagless, nil, nil, map[string]mutator.Status{
+			"5:9 CONDITIONALS_BOUNDARY": mutator.NotCovered, "5:9 CONDITIONALS_NEGATION": mutator.NotCovered,
+		}},
+		{"tagged covered", tagged, []coverage.Block{taggedHeader}, nil, map[string]mutator.Status{
+			"4:16 ARITHMETIC_BASE": mutator.Runnable, "5:9 ARITHMETIC_BASE": mutator.Runnable,
+		}},
+		{"tagged not covered", tagged, nil, nil, map[string]mutator.Status{
+			"4:16 ARITHMETIC_BASE": mutator.NotCovered, "5:9 ARITHMETIC_BASE": mutator.NotCovered,
+		}},
+		{"function literal keeps its own coverage", literal, []coverage.Block{boolHeader}, nil, map[string]mutator.Status{
+			"5:30 CONDITIONALS_BOUNDARY": mutator.NotCovered, "5:30 CONDITIONALS_NEGATION": mutator.NotCovered,
+		}},
+		{"nested switch reached", nested, []coverage.Block{boolHeader, outerBody}, nil, map[string]mutator.Status{
+			"7:10 CONDITIONALS_BOUNDARY": mutator.Runnable, "7:10 CONDITIONALS_NEGATION": mutator.Runnable,
+		}},
+		{"nested switch not reached", nested, []coverage.Block{boolHeader}, nil, map[string]mutator.Status{
+			"7:10 CONDITIONALS_BOUNDARY": mutator.NotCovered, "7:10 CONDITIONALS_NEGATION": mutator.NotCovered,
+		}},
+		{"changed case expression", tagless, []coverage.Block{header}, diff.Diff{"file.go": {{StartLine: 5, EndLine: 5}}}, map[string]mutator.Status{
+			"5:9 CONDITIONALS_BOUNDARY": mutator.Runnable, "5:9 CONDITIONALS_NEGATION": mutator.Runnable,
+		}},
+		{"unchanged case expression", tagless, []coverage.Block{header}, diff.Diff{"file.go": {{StartLine: 4, EndLine: 4}}}, map[string]mutator.Status{
+			"5:9 CONDITIONALS_BOUNDARY": mutator.Skipped, "5:9 CONDITIONALS_NEGATION": mutator.Skipped,
+		}},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			viperSet(map[string]any{configuration.UnleashDryRunKey: true})
+			defer viperReset()
+			mod := gomodule.GoModule{Name: "example.com", Root: ".", CallingDir: "."}
+			fs := fstest.MapFS{"file.go": {Data: []byte(tc.source)}}
+			data := engine.CodeData{Cov: coverage.Profile{"file.go": tc.blocks}, Diff: tc.changes}
+			m := engine.New(mod, data, newJobDealerStub(t), engine.WithDirFs(fs))
+			result := m.Run(context.Background())
+
+			got := map[string]mutator.Status{}
+			for _, mutant := range result.Mutants {
+				pos := mutant.Position()
+				key := fmt.Sprintf("%d:%d %s", pos.Line, pos.Column, mutant.Type())
+				if _, duplicate := got[key]; duplicate {
+					t.Fatalf("duplicate mutant %s in %v", key, result.Mutants)
+				}
+				got[key] = mutant.Status()
+			}
+			if len(got) != len(tc.want) {
+				t.Fatalf("mutants=%v, want %v", got, tc.want)
+			}
+			for key, status := range tc.want {
+				if got[key] != status {
+					t.Errorf("mutant %s is %v, want %v (all: %v)", key, got[key], status, got)
+				}
+			}
+		})
+	}
+}
