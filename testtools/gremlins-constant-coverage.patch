+package engine_test
+
+import (
+	"context"
+	"regexp"
+	"testing"
+	"testing/fstest"
+
+	"github.com/go-gremlins/gremlins/internal/configuration"
+	"github.com/go-gremlins/gremlins/internal/diff"
+	"github.com/go-gremlins/gremlins/internal/engine"
+	"github.com/go-gremlins/gremlins/internal/exclusion"
+	"github.com/go-gremlins/gremlins/internal/gomodule"
+	"github.com/go-gremlins/gremlins/internal/mutator"
+)
+
+func TestConstantMutantsWithoutStatementCoverage(t *testing.T) {
+	for _, tc := range []struct {
+		name    string
+		source  string
+		changes diff.Diff
+		want    mutator.Status
+	}{
+		{"constant-only file", "package example\nconst delay = 10 * 1000\n", nil, mutator.Runnable},
+		{"local constant", "package example\nfunc f() int { const delay = 10 * 1000; return delay }\n", nil, mutator.Runnable},
+		{"unchanged constant", "package example\nconst delay = 10 * 1000\n", diff.Diff{"file.go": nil}, mutator.Skipped},
+		{"changed constant", "package example\nconst delay = 10 * 1000\n", diff.Diff{"file.go": {{StartLine: 2, EndLine: 2}}}, mutator.Runnable},
+		{"ordinary expression remains uncovered", "package example\nfunc f(n int) int { return n * 1000 }\n", nil, mutator.NotCovered},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			viperSet(map[string]any{configuration.UnleashDryRunKey: true})
+			defer viperReset()
+			mod := gomodule.GoModule{Name: "example.com", Root: ".", CallingDir: "."}
+			fs := fstest.MapFS{"file.go": {Data: []byte(tc.source)}}
+			m := engine.New(mod, engine.CodeData{Diff: tc.changes}, newJobDealerStub(t), engine.WithDirFs(fs))
+			result := m.Run(context.Background())
+			if len(result.Mutants) != 1 || result.Mutants[0].Status() != tc.want {
+				t.Fatalf("mutants=%v, want one %v", result.Mutants, tc.want)
+			}
+		})
+	}
+}
+
+func TestConstantMutantsRespectExclusionAndDisabledMutators(t *testing.T) {
+	for _, excluded := range []bool{false, true} {
+		t.Run(map[bool]string{false: "disabled", true: "excluded"}[excluded], func(t *testing.T) {
+			viperSet(map[string]any{
+				configuration.UnleashDryRunKey:                             true,
+				configuration.MutantTypeEnabledKey(mutator.ArithmeticBase): excluded,
+			})
+			defer viperReset()
+			data := engine.CodeData{}
+			if excluded {
+				data.Exclusion = exclusion.Rules{regexp.MustCompile(`^file\.go$`)}
+			}
+			mod := gomodule.GoModule{Name: "example.com", Root: ".", CallingDir: "."}
+			fs := fstest.MapFS{"file.go": {Data: []byte("package example\nconst delay = 10 * 1000\n")}}
+			m := engine.New(mod, data, newJobDealerStub(t), engine.WithDirFs(fs))
+			if result := m.Run(context.Background()); len(result.Mutants) != 0 {
+				t.Fatalf("excluded/disabled constants produced mutants: %v", result.Mutants)
+			}
+		})
+	}
+}
